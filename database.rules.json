{
  "rules": {
    ".read": false,
    ".write": false,
    "courses": {
      ".read": true,
      "$courseId": {
        ".write": "auth != null && auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1'"
      }
    },
    "studentProfiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1' && auth.token.email === 'abidurhussain2@gmail.com'))",
        ".write": "auth != null && auth.uid === $uid && auth.token.email != null",
        ".validate": "!newData.exists() || (newData.hasChildren(['name','email','createdAt']) && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 100 && newData.child('email').isString() && newData.child('email').val() === auth.token.email && newData.child('createdAt').isNumber())"
      }
    },
    "courseResources": {
      "$courseId": {
        ".write": "auth != null && auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1'",
        "notes": {
          ".read": "auth != null && (auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1' || $courseId === 'class10-assamese-free' || root.child('courseAccess').child($courseId).child(auth.uid).child('active').val() === true)"
        },
        "solutions": {
          ".read": "auth != null && (auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1' || root.child('courseAccess').child($courseId).child(auth.uid).child('active').val() === true)"
        },
        "questions": {
          ".read": "auth != null && (auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1' || root.child('courseAccess').child($courseId).child(auth.uid).child('active').val() === true)"
        },
        "papers": {
          ".read": "auth != null && (auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1' || root.child('courseAccess').child($courseId).child(auth.uid).child('active').val() === true)"
        },
        "videos": {
          ".read": "auth != null && (auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1' || (root.child('courseAccess').child($courseId).child(auth.uid).child('active').val() === true && root.child('courseAccess').child($courseId).child(auth.uid).child('package').val() === 'videos'))"
        }
      }
    },
    "accessRequests": {
      "$courseId": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1')",
          ".write": "auth != null && (auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1' || (auth.uid === $uid && newData.exists() && newData.child('studentUid').val() === auth.uid && newData.child('courseId').val() === $courseId && newData.child('status').val() === 'pending' && newData.child('utr').isString() && newData.child('utr').val().length >= 6 && newData.child('utr').val().length <= 40 && ((newData.child('package').val() === 'notes' && newData.child('fee').val() === 299 && newData.child('includesRecordedVideos').val() === false) || (newData.child('package').val() === 'videos' && newData.child('fee').val() === 999 && newData.child('includesRecordedVideos').val() === true))))",
          ".validate": "!newData.exists() || newData.hasChildren(['utr','courseId','package','fee','includesRecordedVideos','status','studentUid','requestedAt'])"
        }
      }
    },
    "courseAccess": {
      "$courseId": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1')",
          ".write": "auth != null && auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1'",
          ".validate": "!newData.exists() || (newData.child('active').isBoolean() && newData.child('package').isString() && (newData.child('package').val() === 'notes' || newData.child('package').val() === 'videos'))"
        }
      }
    },
    "enrollments": {
      ".read": "auth != null && auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1'",
      ".write": "auth != null && auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1'"
    },
    "examControl": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1'"
    },
    "revisionaryTests": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1'"
    },
    "results": {
      "$class": {
        ".read": "auth != null && auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1'",
        "$resultId": {
          ".write": "auth != null && (auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1' || (!data.exists() && newData.hasChildren(['name','score','maxMarks','submittedAt']) && newData.child('name').isString() && newData.child('score').isNumber() && newData.child('maxMarks').isNumber() && newData.child('submittedAt').isNumber()))"
        }
      }
    },
    "teacherEvaluations": {
      ".read": "auth != null && auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1'",
      ".write": "auth != null && auth.uid === 'q8Ybthhc3jQEhQf4e5EAFpYIaDv1'"
    }
  }
}